# ==============================================================
#  BISMILLAH BARAKA — настройки. Скопируйте этот файл в .env
#  и заполните значения. Файл .env НИКОМУ не отправляйте.
# ==============================================================

# --- Telegram ---
# Токен бота от @BotFather (пример формата: 1234567890:AAH...)
BOT_TOKEN=ВСТАВЬТЕ_СЮДА_ТОКЕН_ОТ_BOTFATHER
# Telegram ID администраторов через запятую (узнать ID: @userinfobot)
ADMIN_IDS=8427839550
# Публичный HTTPS-адрес вашего сайта (без / в конце). Пример: https://shop.example.com
WEBAPP_URL=https://ваш-домен.com
# Куда отправлять уведомления о новых заказах:
#   публичная группа — @username группы; закрытая группа — числовой ID (-100...), узнать командой /chatid
NOTIFY_CHAT_ID=@botbismillahbarakosh
# Дублировать уведомления администраторам в личные сообщения (true/false)
NOTIFY_ADMINS_PRIVATE=true
# Язык уведомлений для администратора: ru или uz
ADMIN_LANGUAGE=ru
# Запускать бота вместе с сайтом (true). false — только сайт (для тестов)
RUN_BOT=true

# --- Безопасность ---
# Любая длинная случайная строка (для подписи ссылок на чеки)
SECRET_KEY=замените-на-длинную-случайную-строку
# Сколько секунд действительны данные входа Telegram (86400 = 24 часа)
INITDATA_MAX_AGE=86400
# Режим разработчика: позволяет открыть сайт в обычном браузере без Telegram.
# НИКОГДА не включайте на реальном сервере!
DEV_MODE=false
DEV_USER_ID=0

# --- Бизнес (потом всё меняется в админ-панели) ---
BUSINESS_NAME=BISMILLAH BARAKA
CURRENCY=SAR
PRIMARY_LANGUAGE=uz
TIMEZONE=Asia/Riyadh
# Номер первого заказа = 1 + ORDER_NUMBER_OFFSET (1000 → первый заказ №1001)
ORDER_NUMBER_OFFSET=1000

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
# Пусто = SQLite-файл database/shop.db. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shop
DATABASE_URL=
# Максимальный размер загружаемого фото, МБ
MAX_UPLOAD_MB=8
